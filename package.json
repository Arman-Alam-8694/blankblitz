{
  "name": "blankblitz",
  "private": true,
  "version": "0.1.0",
  "description": "Zero-login multiplayer word-guessing party game",
  "workspaces": [
    "shared",
    "backend",
    "frontend"
  ],
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c cyan,magenta \"npm:dev -w backend\" \"npm:dev -w frontend\"",
    "build": "npm run build -w frontend",
    "start": "npm run start -w backend",
    "typecheck": "npm run typecheck -w shared && npm run typecheck -w backend && npm run typecheck -w frontend",
    "test": "npm run test -w backend"
  },
  "devDependencies": {
    "concurrently": "^9.2.5",
    "typescript": "^5.9.3"
  }
}
