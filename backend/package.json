    "socket.io": "^4.8.1",
    "tsx": "^4.20.0",
    "word-list": "^4.1.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^24.0.0",
    "socket.io-client": "^4.8.1",
    "vitest": "^4.0.0"
  }
