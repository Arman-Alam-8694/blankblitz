{
  "name": "@blankblitz/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "cross-env PORT=3001 tsx watch --clear-screen=false src/index.ts",
    "start": "cross-env NODE_ENV=production tsx src/index.ts",
